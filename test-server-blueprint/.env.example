# Copy to .env — local stub hub; align JWT_SECRET / APP_AUDIENCE with frontend/.env

SSO_MODE=dev

DEV_USER_EMAIL=demo@example.com

# Must match frontend JWT_SECRET
JWT_SECRET=local-dev-shared-sso-secret

APP_AUDIENCE=blueprint-app

PORTAL_URL=http://localhost:5000

STUB_PORTAL_ENABLED=true
# Use the same host you open in the browser (localhost vs 127.0.0.1 must match).
STUB_CLIENT_CALLBACK=http://localhost:5173/sso/login

SERVER_SECRET_KEY=local-flask-server-secret-change-me

MAX_SESSIONS_PER_USER=3
MAX_SESSIONS_GLOBAL=100

PORT=3020

DEBUG=False
