# ============================================================
# UseIt – Intelligent Device Documentation Platform
# ============================================================
# Copia questo file in .env e configura i valori

# ============================================================
# QDRANT — vector database (server esterno, NON nel container)
# ============================================================
QDRANT_URL=http://qdrant.sitai.duckdns.org
# QDRANT_API_KEY=
# In production keep this false — the app fails fast if Qdrant is unreachable
# Set to true only for local dev without a Qdrant server
# QDRANT_ALLOW_EMBEDDED=false

# ============================================================
# PDF STORAGE — path dove vengono salvati i PDF caricati
# In Docker: deve corrispondere al volume mount in docker-compose.yml
# ============================================================
# PDFS_DIR=/app/frontend/static/pdf-source

# ============================================================
# SSO — valida JWT emessi dal portale del prof (Checkin)
# ============================================================
SSO_MODE=production
# Segreto JWT condiviso con il portale SSO del prof
USEIT_JWT_SECRET=
JWT_ISSUER=sso-portal
APP_AUDIENCE=blueprint-app
# URL del portale SSO del prof (dove reindirizzare gli utenti non autenticati)
PORTAL_URL=http://localhost:5000

# ============================================================
# SESSIONE — segreto per firmare i cookie di sessione SvelteKit
# ============================================================
SESSION_SECRET=

# ============================================================
# CORS — origini consentite per il backend FastAPI
# ============================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================
# FRONTEND — URL del backend come visto dal browser del client
# (in produzione: l'IP/hostname pubblico del server)
# ============================================================
PUBLIC_BACKEND_URL=http://localhost:8000

# ============================================================
# APPLICAZIONE
# ============================================================
LOG_LEVEL=INFO
DEV_USER_EMAIL=demo@example.com
MAX_SESSIONS_PER_USER=3
MAX_SESSIONS_GLOBAL=100
SESSION_TTL_SECONDS=28800
