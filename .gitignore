# Node / SvelteKit (frontend)
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
frontend/.svelte-kit/
frontend/build/
frontend/.vite/

# Python (backend)
backend/.venv/
backend/__pycache__/
backend/app/__pycache__/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.mypy_cache/
backend/.pytest_cache/
backend/myvenv/

# Qdrant storage (local/embedded mode)
qdrant_local/
qdrant_storage/

# Environment & secrets
.env
*/.env
frontend/.env
backend/env.local
backend/.env.*
backend/env.*

# PDF files (large binary assets — use downloadpdf.py to regenerate)
*.pdf
frontend/static/pdf-source/

# OS / editor junk
*.log
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# IDE / tooling
.vscode/
.idea/
*.code-workspace
