# SSO client (SvelteKit) — copy to .env
#
# --- Test “come produzione” (JWT reale dal server) ---
# 1) SSO_MODE=production e PORTAL_URL come sotto
# 2) Altro terminale: npm run dev:test-server (da root repo)
# 3) Apri il client → redirect al hub → pagina “Accedi e invia JWT al client” → poi /session per i claims
#
# Senza hub: SSO_MODE=dev

SSO_MODE=production

# Same JWT_SECRET as test-server-blueprint (stub signs tokens with this)
JWT_SECRET=local-dev-shared-sso-secret

JWT_ISSUER=sso-portal
APP_AUDIENCE=blueprint-app

# Your network hub later, or local stub: http://127.0.0.1:3020/stub-portal
PORTAL_URL=http://localhost:3020/stub-portal

SESSION_SECRET=local-dev-session-secret-ok

# WHITELIST_PATH=
# MAX_SESSIONS_PER_USER=3
# MAX_SESSIONS_GLOBAL=100
# SESSION_TTL_SECONDS=28800
# DEV_USER_EMAIL=demo@example.com
# FORCE_SECURE_COOKIES=true|false

# FastAPI backend URL (used by the browser to call the backend directly)
PUBLIC_BACKEND_URL=http://localhost:8000
# Backend URL for the FastAPI service
# Copy this file to .env and adjust as needed
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
